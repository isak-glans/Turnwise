@inherits EncounterStateAwareComponentBase
@inject EncounterFileService EncounterFileService
@inject FileDownloadService FileDownload

<div class="app-header card">
    <div class="brand">
        <span class="brand-icon">⚔️</span>
        <span class="brand-title">Turnwise</span>
    </div>

    <div class="encounter-name-field">
        <input class="encounter-name-input" @bind="State.Current.Name" @bind:event="oninput" placeholder="Encounter name" />
        <i class="bi bi-pencil"></i>
    </div>

    <div class="header-actions">
        <label class="btn file-button" title="Loading will overwrite the current encounter.">
            <i class="bi bi-folder2-open"></i> Load Encounter
            <InputFile OnChange="LoadEncounter" accept=".json" />
        </label>
        <button class="btn" @onclick="SaveEncounter"><i class="bi bi-save"></i> Save Encounter</button>
        <button class="btn" @onclick="NewEncounter"><i class="bi bi-plus-lg"></i> New Encounter</button>
    </div>
</div>
@if (!string.IsNullOrEmpty(_error))
{
    <div class="error-banner">@_error</div>
}

@code {
    private string? _error;

    private void NewEncounter() => State.NewEncounter();

    private async Task SaveEncounter()
    {
        using var stream = new MemoryStream();
        await EncounterFileService.SaveEncounterAsync(State.Current, stream);
        var fileName = $"{Sanitize(State.Current.Name)}.turnwise-encounter.json";
        await FileDownload.DownloadAsync(fileName, "application/json", stream.ToArray());
    }

    private async Task LoadEncounter(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 10_000_000);
            var encounter = await EncounterFileService.LoadEncounterAsync(stream);
            State.ReplaceEncounter(encounter);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load encounter: {ex.Message}";
            State.NotifyChanged();
        }
    }

    private static string Sanitize(string name) =>
        string.Concat(name.Where(c => !Path.GetInvalidFileNameChars().Contains(c))).Replace(' ', '-');
}

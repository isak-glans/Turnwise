@inherits EncounterStateAwareComponentBase

<div class="panel card log-panel">
    <button class="log-toggle" @onclick="Toggle">
        <i class="bi bi-file-text"></i>
        Combat Log (@State.Current.Log.Count)
        <i class="bi bi-chevron-down chevron @(_expanded ? "open" : "")" style="margin-left:auto"></i>
    </button>
    @if (_expanded)
    {
        <ul class="log-list">
            @foreach (var entry in State.Current.Log.OrderByDescending(e => e.Timestamp))
            {
                <li @key="entry.Id">
                    <span class="log-time">@entry.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                    <span class="log-type">@FormatType(entry.Type)</span>
                    @if (!string.IsNullOrEmpty(entry.Result))
                    {
                        <strong class="log-result">@entry.Result</strong>
                    }
                    @entry.Message
                </li>
            }
        </ul>
    }
</div>

@code {
    private bool _expanded;

    private void Toggle() => _expanded = !_expanded;

    private static string FormatType(CombatLogEntryType type) => type switch
    {
        CombatLogEntryType.HpChange => "HP",
        CombatLogEntryType.InitiativeChange => "Initiative",
        CombatLogEntryType.DiceRoll => "Roll",
        _ => type.ToString()
    };
}

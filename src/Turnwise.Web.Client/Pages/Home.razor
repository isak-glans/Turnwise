@page "/"
@using Turnwise.Application.Services
@using Turnwise.Domain.Entities
@inject EncounterService EncounterService

<PageTitle>Turnwise WASM spike</PageTitle>

<h1>Blazor WebAssembly spike</h1>

<p>
    Proves the Domain/Application/Infrastructure layers - unchanged from the Blazor Server
    app - resolve via DI and run correctly under a pure WebAssembly host: no server, no
    SignalR circuit. This runs entirely in the browser.
</p>

<button class="btn btn-primary" @onclick="RunSmokeTest">Run smoke test</button>

@if (_log is not null)
{
    <pre>@_log</pre>
}

@code {
    private string? _log;

    private void RunSmokeTest()
    {
        var encounter = new Encounter("WASM Spike Encounter");
        var goblin = new Combatant("Goblin", 12) { InitiativeFormula = "1d20+2" };
        encounter.AddCombatant(goblin);

        var initiativeResult = EncounterService.RollInitiative(encounter, goblin.Id);
        var applied = EncounterService.ApplyHpDelta(encounter, goblin.Id, -5);

        var lines = new List<string>
        {
            $"Rolled initiative: {initiativeResult}",
            $"Applied HP delta: {applied} (now {goblin.CurrentHp}/{goblin.MaxHp})",
            "Combat log:"
        };
        lines.AddRange(encounter.Log.Select(e => $"  - {e.Message}" + (e.Result is null ? "" : $" -> {e.Result}")));

        _log = string.Join("\n", lines);
    }
}

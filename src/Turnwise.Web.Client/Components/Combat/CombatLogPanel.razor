@inherits EncounterStateAwareComponentBase

<div class="panel card log-panel">
    <div class="log-toggle">
        <span class="log-toggle-label"><i class="bi bi-file-text"></i> Combat Log (@State.Current.Log.Count)</span>
        @if (State.Current.Log.Count > 1)
        {
            <select class="log-filter-select" title="Filter" @onchange="OnFilterChanged">
                @foreach (var option in FilterOptions)
                {
                    <option value="@(option.Type?.ToString() ?? "")" selected="@(_filterType == option.Type)">@option.Label</option>
                }
            </select>
        }
    </div>

    <ul class="log-list">
        @foreach (var entry in FilteredLog())
        {
            <li @key="entry.Id">
                <span class="log-time">@entry.Timestamp.ToLocalTime().ToString("HH:mm")</span>
                @if (IsWeaponRoll(entry))
                {
                    <span class="emoji-icon log-type-icon" title="@FormatType(entry.Type)">@NamedRollCategories.WeaponEmoji</span>
                }
                else
                {
                    <i class="bi @(IconFor(entry)) log-type-icon" title="@FormatType(entry.Type)"></i>
                }
                @entry.Message
                @if (!string.IsNullOrEmpty(entry.Result))
                {
                    <strong class="log-result">&nbsp;→ @entry.Result</strong>
                }
            </li>
        }
    </ul>
</div>

@code {
    private CombatLogEntryType? _filterType;

    private void OnFilterChanged(ChangeEventArgs e) =>
        _filterType = Enum.TryParse<CombatLogEntryType>(e.Value?.ToString(), out var type) ? type : null;

    private static readonly (CombatLogEntryType? Type, string Label)[] FilterOptions =
    [
        (null, "All"),
        (CombatLogEntryType.HpChange, "HP"),
        (CombatLogEntryType.InitiativeChange, "Initiative"),
        (CombatLogEntryType.DiceRoll, "Rolls"),
        (CombatLogEntryType.ConditionChange, "Conditions"),
        (CombatLogEntryType.RoundChange, "Rounds")
    ];

    private IEnumerable<CombatLogEntry> FilteredLog()
    {
        var entries = _filterType is { } type
            ? State.Current.Log.Where(e => e.Type == type)
            : State.Current.Log;
        return entries.OrderByDescending(e => e.Timestamp);
    }

    /// <summary>Icon for a filter chip, where there is no specific entry to read a roll category from.</summary>
    private static string IconFor(CombatLogEntryType? type) => type switch
    {
        CombatLogEntryType.HpChange => "bi-heart-fill",
        CombatLogEntryType.InitiativeChange => "bi-dice-5-fill",
        CombatLogEntryType.DiceRoll => "bi-dice-6-fill",
        CombatLogEntryType.ConditionChange => "bi-exclamation-triangle-fill",
        CombatLogEntryType.RoundChange => "bi-flag-fill",
        _ => "bi-list-ul"
    };

    /// <summary>Icon for an actual log entry - a dice roll with a category uses that category's icon instead of the generic one.</summary>
    private static string IconFor(CombatLogEntry entry) =>
        entry.Type == CombatLogEntryType.DiceRoll && entry.RollCategory is { } category
            ? NamedRollCategories.GetIcon(category)
            : IconFor(entry.Type);

    /// <summary>Weapon rolls render as an emoji instead of a "bi-*" icon class - see <see cref="NamedRollCategories.IsEmoji"/>.</summary>
    private static bool IsWeaponRoll(CombatLogEntry entry) =>
        entry.Type == CombatLogEntryType.DiceRoll && NamedRollCategories.IsEmoji(entry.RollCategory);

    private static string FormatType(CombatLogEntryType type) => type switch
    {
        CombatLogEntryType.HpChange => "HP",
        CombatLogEntryType.InitiativeChange => "Initiative",
        CombatLogEntryType.DiceRoll => "Roll",
        CombatLogEntryType.ConditionChange => "Condition",
        CombatLogEntryType.RoundChange => "Round",
        _ => type.ToString()
    };
}

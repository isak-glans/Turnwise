    private void AddRoll(Combatant combatant)
    {
        if (string.IsNullOrWhiteSpace(_newRollName))
        {
            return;
        }

        if (!DiceFormula.TryParse(_newRollFormula, out var formula))
        {
            _error = $"'{_newRollFormula}' is not a valid dice formula (e.g. 1d20+4).";
            State.NotifyChanged();
            return;
        }

        var category = Enum.TryParse<NamedRollCategory>(_newRollCategory, out var parsedCategory) ? parsedCategory : (NamedRollCategory?)null;
        combatant.AddNamedRoll(_newRollName, formula!, category: category);
        _newRollName = "";
        _newRollFormula = "";
        _newRollCategory = "";
        _showAddRoll = false;
        _error = null;
        State.NotifyChanged();
    }


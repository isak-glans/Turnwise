    private void ApplyHpDelta(Combatant combatant, bool heal)
    {
        if (HpAmount.TryParse(_hpDelta, out var amount))
        {
            State.CaptureUndoSnapshot();
            EncounterService.ApplyHpDelta(State.Current, combatant.Id, heal ? amount : -amount);
            _hpDelta = "";
            _error = null;
        }
        else
        {
            _error = $"'{_hpDelta}' is not a valid amount - enter a positive whole number.";
        }
        State.NotifyChanged();
    }


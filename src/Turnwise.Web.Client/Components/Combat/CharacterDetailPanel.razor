@inherits EncounterStateAwareComponentBase
@inject EncounterService EncounterService
@inject CharacterTemplateService CharacterTemplateService
@inject FileDownloadService FileDownload
@inject IJSRuntime JS

<div class="panel card">
    @if (State.SelectedCombatant is null)
    {
        <div class="panel-header">
            <h2><i class="bi bi-person-badge"></i> Character</h2>
        </div>
        <p class="empty-hint">Select a combatant from the initiative list.</p>
    }
    else
    {
        var combatant = State.SelectedCombatant;
        <div class="panel-header">
            <h2><i class="bi bi-person-badge"></i> Character</h2>
            <div class="menu-wrap">
                <button id="menu-trigger-char" class="icon-btn" title="More actions" @onclick='() => ToggleMenu("menu-trigger-char")'>
                    <i class="bi bi-three-dots-vertical"></i>
                </button>
                @if (IsMenuOpen("menu-trigger-char"))
                {
                    <div class="dropdown-menu" @ref="_menuRef">
                        <button class="dropdown-item" @onclick="() => SaveAsTemplate(combatant)"><i class="bi bi-download"></i> Save as template</button>
                        <button class="dropdown-item" @onclick="() => DuplicateCombatant(combatant)"><i class="bi bi-copy"></i> Duplicate</button>
                        <button class="dropdown-item danger" @onclick="() => RemoveCombatant(combatant)"><i class="bi bi-trash"></i> Remove from encounter</button>
                    </div>
                }
            </div>
        </div>

        <div class="detail-header">
            <div class="avatar-wrap">
                <span class="avatar avatar-lg" style="@(HasPortrait(combatant) ? "" : $"background:{AvatarHelper.ColorFor(combatant.Id)}")">
                    @if (HasPortrait(combatant))
                    {
                        <img src="data:image/png;base64,@combatant.PortraitBase64" alt="" />
                    }
                    else
                    {
                        @AvatarHelper.InitialsFor(combatant.Name)
                    }
                </span>
                <label class="avatar-edit-btn" title="Change portrait">
                    <i class="bi bi-pencil"></i>
                    <InputFile OnChange="e => ChangePortrait(combatant, e)" accept="image/*" />
                </label>
            </div>
            <div class="detail-title">
                <input class="name-input-lg" value="@combatant.Name" maxlength="@Combatant.MaxNameLength" @oninput="e => RenameCombatant(combatant, e)" />
            </div>
            @if (combatant.Id == State.Current.ActiveCombatantId)
            {
                <span class="badge badge-active"><i class="bi bi-lightning-fill"></i> Active</span>
            }
        </div>

        <div class="hp-quick-bar">
            <span class="stats-chip" title="HP"><i class="bi bi-heart-fill"></i> @combatant.CurrentHp/@combatant.MaxHp</span>
            @if (combatant.TemporaryHp > 0)
            {
                <span class="stats-chip stats-chip-temp" title="Temporary HP - absorbs damage first">
                    <i class="bi bi-shield-fill"></i> +@combatant.TemporaryHp temp
                </span>
            }
            <div class="stats-control hp-amount-control">
                <input @bind="_hpDelta" @bind:event="oninput" type="text" inputmode="numeric" autocomplete="off" placeholder="Amount"
                       title="Enter an amount, then Damage or Heal. Damage reduces temporary HP first." @onkeydown="e => HandleHpDeltaKeyDown(e, combatant)" />
                <button class="btn btn-sm btn-damage" @onclick="() => ApplyHpDelta(combatant, heal: false)"><i class="bi bi-heartbreak-fill"></i> Damage</button>
                <button class="btn btn-sm btn-heal" @onclick="() => ApplyHpDelta(combatant, heal: true)"><i class="bi bi-heart-pulse-fill"></i> Heal</button>
            </div>
        </div>

        <div class="accordion">
            @{
                var detailsOpen = State.IsSectionOpen(combatant.Id, "details");
                var rollsOpen = State.IsSectionOpen(combatant.Id, "rolls");
                var countersOpen = State.IsSectionOpen(combatant.Id, "counters");
                var conditionsOpen = State.IsSectionOpen(combatant.Id, "conditions");
                var notesOpen = State.IsSectionOpen(combatant.Id, "notes");
            }

            <div class="accordion-section">
                <button class="accordion-header" aria-expanded="@detailsOpen" @onclick='() => State.ToggleSection(combatant.Id, "details")'>
                    <i class="bi bi-sliders"></i>
                    <span class="accordion-title">Details</span>
                    <i class="bi @(detailsOpen ? "bi-chevron-up" : "bi-chevron-down") accordion-chevron"></i>
                </button>
                @if (detailsOpen)
                {
                <div class="accordion-body">
                    <div class="stats-section">
                        <div class="stats-row">
                            <div class="stats-row-main">
                                <div class="stats-label">
                                    <span class="stat-icon icon-danger"><i class="bi bi-heart-fill"></i></span>
                                    <span>Max HP</span>
                                </div>
                                <div class="stats-value">
                                    <input type="number" class="stat-big-input" value="@combatant.MaxHp" min="0"
                                           title="Max HP" @onchange="e => SetMaxHp(combatant, e)" />
                                </div>
                                <div class="stats-control">
                                    <input @bind="combatant.MaxHpFormula" placeholder="e.g. 8d6+16" maxlength="@DiceFormula.MaxNotationLength" />
                                    <button class="btn btn-sm" @onclick="() => RollMaxHp(combatant)"><i class="bi bi-dice-6-fill"></i> Roll</button>
                                </div>
                            </div>
                        </div>

                        <div class="stats-divider"></div>

                        <div class="stats-row">
                            <div class="stats-row-main">
                                <div class="stats-label">
                                    <span class="stat-icon icon-danger"><i class="bi bi-shield-fill"></i></span>
                                    <span>Temp HP</span>
                                </div>
                                <div class="stats-value">
                                    <input type="number" class="stat-big-input narrow" value="@combatant.TemporaryHp" min="0"
                                           title="Temporary HP - absorbs damage before regular HP does" @onchange="e => SetTemporaryHp(combatant, e)" />
                                </div>
                            </div>
                        </div>

                        <div class="stats-divider"></div>

                        <div class="stats-row">
                            <div class="stats-row-main">
                                <div class="stats-label">
                                    <span class="stat-icon icon-accent"><i class="bi bi-dice-5-fill"></i></span>
                                    <span>Initiative</span>
                                </div>
                                <div class="stats-value">
                                    <input type="number" class="stat-big-input" value="@combatant.Initiative"
                                           title="Current initiative" placeholder="—" @onchange="e => SetInitiative(combatant, e)" />
                                </div>
                                <div class="stats-control">
                                    <input @bind="combatant.InitiativeFormula" placeholder="e.g. 1d20+2" maxlength="@DiceFormula.MaxNotationLength" />
                                    <button class="btn btn-sm" @onclick="() => RollInitiative(combatant)"><i class="bi bi-dice-6-fill"></i> Roll</button>
                                </div>
                            </div>
                        </div>

                        <div class="stats-divider"></div>

                        <div class="stats-row">
                            <div class="stats-row-main">
                                <div class="stats-label">
                                    <span class="stat-icon icon-accent"><i class="bi bi-shield-fill"></i></span>
                                    <span>Defence</span>
                                </div>
                                <div class="stats-value">
                                    <input type="number" class="stat-big-input narrow" value="@combatant.ArmorClass" min="0" placeholder="—"
                                           title="Defence (leave blank to hide)" @onchange="e => SetArmorClass(combatant, e)" />
                                </div>
                            </div>
                        </div>

                        <div class="stats-divider"></div>

                        <div class="stats-row">
                            <div class="stats-row-main">
                                <div class="stats-label">
                                    <span>Category</span>
                                </div>
                                <div class="stats-value">
                                    <select class="category-select category-@(combatant.Category?.ToString().ToLowerInvariant() ?? "none")" title="Category" @onchange="e => SetCategory(combatant, e)">
                                        <option value="" selected="@(combatant.Category is null)">No category</option>
                                        @foreach (var category in Enum.GetValues<CombatantCategory>())
                                        {
                                            <option value="@category" selected="@(combatant.Category == category)">@category</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                }
            </div>

            <div class="accordion-section">
                <button class="accordion-header" aria-expanded="@rollsOpen" @onclick='() => State.ToggleSection(combatant.Id, "rolls")'>
                    <i class="bi bi-dice-6"></i>
                    <span class="accordion-title">Dice Rolls</span>
                    <i class="bi @(rollsOpen ? "bi-chevron-up" : "bi-chevron-down") accordion-chevron"></i>
                </button>
            @if (rollsOpen)
            {
                <div class="accordion-body">
                    <div class="section-header">
                        <span></span>
                        <button class="btn btn-sm" @onclick="() => _showAddRoll = !_showAddRoll"><i class="bi bi-plus-lg"></i> Add roll</button>
                    </div>
                    @if (combatant.NamedRolls.Count > 4)
                    {
                        <div class="filter-row">
                            <input class="filter-input" value="@State.GetRollFilter(combatant.Id)"
                                   @oninput='e => State.SetRollFilter(combatant.Id, e.Value?.ToString() ?? "")' placeholder="Search rolls..." />
                            @if (!string.IsNullOrEmpty(State.GetRollFilter(combatant.Id)))
                            {
                                <button class="icon-btn-ghost filter-clear" title="Clear filter" @onclick='() => State.SetRollFilter(combatant.Id, "")'><i class="bi bi-x"></i></button>
                            }
                        </div>
                    }
                    <ul class="scrollable-list">
                        @foreach (var roll in FilterRolls(combatant, State.GetRollFilter(combatant.Id)))
                        {
                            var index = IndexOf(combatant.NamedRolls, roll);
                            var triggerId = $"menu-trigger-roll-{roll.Id}";
                            var rollsFiltered = !string.IsNullOrEmpty(State.GetRollFilter(combatant.Id));
                            <li class="roll-row @(_editingRollId == roll.Id ? "editing" : "")">
                                <span class="reorder-buttons">
                                    <button title="@(rollsFiltered ? "Clear the search to reorder" : "Move up")" disabled="@(rollsFiltered || index == 0)" @onclick="() => MoveRoll(combatant, index, -1)"><i class="bi bi-chevron-up"></i></button>
                                    <button title="@(rollsFiltered ? "Clear the search to reorder" : "Move down")" disabled="@(rollsFiltered || index == combatant.NamedRolls.Count - 1)" @onclick="() => MoveRoll(combatant, index, 1)"><i class="bi bi-chevron-down"></i></button>
                                </span>
                                <span class="stat-icon icon-accent">
                                    @if (NamedRollCategories.IsEmoji(roll.Category))
                                    {
                                        <span class="emoji-icon">@NamedRollCategories.WeaponEmoji</span>
                                    }
                                    else
                                    {
                                        <i class="bi @(NamedRollCategories.GetIcon(roll.Category))"></i>
                                    }
                                </span>
                                @if (_editingRollId == roll.Id)
                                {
                                    <input class="inline-edit-input" @bind="_editRollName" placeholder="Name" maxlength="@NamedRoll.MaxNameLength" />
                                    <input class="inline-edit-input" @bind="_editRollFormula" placeholder="1d20+4" maxlength="@DiceFormula.MaxNotationLength" />
                                    <select class="inline-edit-input narrow" @bind="_editRollCategory">
                                        <option value="">No category</option>
                                        @foreach (var category in Enum.GetValues<NamedRollCategory>())
                                        {
                                            <option value="@category">@category</option>
                                        }
                                    </select>
                                    <button class="btn btn-sm btn-primary" @onclick="() => SaveRollEdit(roll)">Save</button>
                                    <button class="btn btn-sm" @onclick="() => _editingRollId = null">Cancel</button>
                                }
                                else
                                {
                                    <span class="roll-info">
                                        <span class="roll-name">@roll.Name</span>
                                    </span>
                                    <span class="formula-box">@roll.Formula</span>
                                    <button class="btn btn-sm roll-action" @onclick="() => RollNamed(combatant, roll.Id)">Roll</button>
                                    <div class="menu-wrap">
                                        <button id="@triggerId" class="icon-btn-ghost" title="More" @onclick="() => ToggleMenu(triggerId)">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        @if (IsMenuOpen(triggerId))
                                        {
                                            <div class="dropdown-menu row-menu" @ref="_menuRef">
                                                <button class="dropdown-item" @onclick="() => StartEditRoll(roll)"><i class="bi bi-pencil"></i> Edit</button>
                                                <button class="dropdown-item" @onclick="() => DuplicateRoll(combatant, roll.Id)"><i class="bi bi-copy"></i> Duplicate</button>
                                                <button class="dropdown-item danger" @onclick="() => RemoveRoll(combatant, roll.Id)"><i class="bi bi-trash"></i> Delete</button>
                                            </div>
                                        }
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                    @if (_showAddRoll)
                    {
                        <div class="add-inline-form">
                            <input @bind="_newRollName" placeholder="Name" maxlength="@NamedRoll.MaxNameLength" />
                            <input @bind="_newRollFormula" placeholder="1d20+4" maxlength="@DiceFormula.MaxNotationLength" />
                            <select @bind="_newRollCategory">
                                <option value="">No category</option>
                                @foreach (var category in Enum.GetValues<NamedRollCategory>())
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                            <button class="btn btn-primary" @onclick="() => AddRoll(combatant)">Add</button>
                        </div>
                    }
                </div>
            }
            </div>

            <div class="accordion-section">
                <button class="accordion-header" aria-expanded="@countersOpen" @onclick='() => State.ToggleSection(combatant.Id, "counters")'>
                    <i class="bi bi-stack"></i>
                    <span class="accordion-title">Counters</span>
                    <i class="bi @(countersOpen ? "bi-chevron-up" : "bi-chevron-down") accordion-chevron"></i>
                </button>
            @if (countersOpen)
            {
                <div class="accordion-body">
                    <div class="section-header">
                        <span></span>
                        <button class="btn btn-sm" @onclick="() => _showAddCounter = !_showAddCounter"><i class="bi bi-plus-lg"></i> Add counter</button>
                    </div>
                    @if (combatant.Counters.Count > 4)
                    {
                        <div class="filter-row">
                            <input class="filter-input" value="@State.GetCounterFilter(combatant.Id)"
                                   @oninput='e => State.SetCounterFilter(combatant.Id, e.Value?.ToString() ?? "")' placeholder="Search counters..." />
                            @if (!string.IsNullOrEmpty(State.GetCounterFilter(combatant.Id)))
                            {
                                <button class="icon-btn-ghost filter-clear" title="Clear filter" @onclick='() => State.SetCounterFilter(combatant.Id, "")'><i class="bi bi-x"></i></button>
                            }
                        </div>
                    }
                    <ul class="scrollable-list">
                        @foreach (var counter in FilterCounters(combatant, State.GetCounterFilter(combatant.Id)))
                        {
                            var index = IndexOf(combatant.Counters, counter);
                            var triggerId = $"menu-trigger-counter-{counter.Id}";
                            var countersFiltered = !string.IsNullOrEmpty(State.GetCounterFilter(combatant.Id));
                            <li class="counter-row @(_editingCounterId == counter.Id ? "editing" : "")">
                                <span class="reorder-buttons">
                                    <button title="@(countersFiltered ? "Clear the search to reorder" : "Move up")" disabled="@(countersFiltered || index == 0)" @onclick="() => MoveCounter(combatant, index, -1)"><i class="bi bi-chevron-up"></i></button>
                                    <button title="@(countersFiltered ? "Clear the search to reorder" : "Move down")" disabled="@(countersFiltered || index == combatant.Counters.Count - 1)" @onclick="() => MoveCounter(combatant, index, 1)"><i class="bi bi-chevron-down"></i></button>
                                </span>
                                <span class="stat-icon icon-accent"><i class="bi @(CounterCategories.GetIcon(counter.Category))"></i></span>
                                @if (_editingCounterId == counter.Id)
                                {
                                    <input class="inline-edit-input" @bind="_editCounterName" placeholder="Name" maxlength="@Counter.MaxNameLength" />
                                    <input class="inline-edit-input narrow" type="number" min="0" @bind="_editCounterMax" placeholder="Max" />
                                    <select class="inline-edit-input narrow" @bind="_editCounterCategory">
                                        <option value="">No category</option>
                                        @foreach (var category in Enum.GetValues<CounterCategory>())
                                        {
                                            <option value="@category">@category</option>
                                        }
                                    </select>
                                    <button class="btn btn-sm btn-primary" @onclick="() => SaveCounterEdit(counter)">Save</button>
                                    <button class="btn btn-sm" @onclick="() => _editingCounterId = null">Cancel</button>
                                }
                                else
                                {
                                    <span class="counter-name">@counter.Name</span>
                                    <span class="counter-stepper">
                                        <button class="btn counter-step-btn" @onclick="() => AdjustCounter(counter, -1)"><i class="bi bi-dash"></i></button>
                                        <span class="counter-value">@counter.Current / @counter.Max</span>
                                        <button class="btn counter-step-btn" @onclick="() => AdjustCounter(counter, 1)"><i class="bi bi-plus"></i></button>
                                    </span>
                                    <div class="menu-wrap">
                                        <button id="@triggerId" class="icon-btn-ghost" title="More" @onclick="() => ToggleMenu(triggerId)">
                                            <i class="bi bi-three-dots"></i>
                                        </button>
                                        @if (IsMenuOpen(triggerId))
                                        {
                                            <div class="dropdown-menu row-menu" @ref="_menuRef">
                                                <button class="dropdown-item" @onclick="() => StartEditCounter(counter)"><i class="bi bi-pencil"></i> Edit</button>
                                                <button class="dropdown-item" @onclick="() => DuplicateCounter(combatant, counter.Id)"><i class="bi bi-copy"></i> Duplicate</button>
                                                <button class="dropdown-item danger" @onclick="() => RemoveCounter(combatant, counter.Id)"><i class="bi bi-trash"></i> Delete</button>
                                            </div>
                                        }
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                    @if (_showAddCounter)
                    {
                        <div class="add-inline-form">
                            <input @bind="_newCounterName" placeholder="e.g. Ammo, Ki, Rage" maxlength="@Counter.MaxNameLength" />
                            <input type="number" min="0" @bind="_newCounterMax" placeholder="Max" />
                            <select @bind="_newCounterCategory">
                                <option value="">No category</option>
                                @foreach (var category in Enum.GetValues<CounterCategory>())
                                {
                                    <option value="@category">@category</option>
                                }
                            </select>
                            <button class="btn btn-primary" @onclick="() => AddCounter(combatant)">Add</button>
                        </div>
                    }
                </div>
            }
            </div>

            <div class="accordion-section">
                <button class="accordion-header" aria-expanded="@conditionsOpen" @onclick='() => State.ToggleSection(combatant.Id, "conditions")'>
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span class="accordion-title">Conditions</span>
                    @if (combatant.Conditions.Count > 0)
                    {
                        <span class="accordion-count">@combatant.Conditions.Count</span>
                    }
                    <i class="bi @(conditionsOpen ? "bi-chevron-up" : "bi-chevron-down") accordion-chevron"></i>
                </button>
            @if (conditionsOpen)
            {
                <div class="accordion-body">
                    <div class="section-header">
                        <span></span>
                        <button class="btn btn-sm" @onclick="() => _showAddCondition = !_showAddCondition">
                            <i class="bi @(_showAddCondition ? "bi-x-lg" : "bi-plus-lg")"></i> @(_showAddCondition ? "Close" : "Add condition")
                        </button>
                    </div>
                    @if (combatant.Conditions.Count > 0)
                    {
                        <h4 class="subsection-heading">Active</h4>
                        <div class="condition-pills">
                            @foreach (var condition in combatant.Conditions)
                            {
                                <span class="condition-pill">
                                    <i class="bi @(ConditionPresets.GetIcon(condition.Name))"></i>
                                    @condition.Name
                                    <button class="icon-btn-ghost" title="Remove condition" @onclick="() => RemoveCondition(combatant, condition.Id)"><i class="bi bi-x"></i></button>
                                </span>
                            }
                        </div>
                    }
                    @if (_showAddCondition)
                    {
                        var available = AvailablePresets(combatant);
                        @if (available.Count > 0)
                        {
                            <h4 class="subsection-heading">Available</h4>
                            <div class="condition-picker">
                                @foreach (var preset in available)
                                {
                                    <button class="condition-picker-item" @onclick="() => AddCondition(combatant, preset)">
                                        <i class="bi @(ConditionPresets.GetIcon(preset))"></i> @preset
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="empty-hint">All conditions already added.</p>
                        }
                    }
                </div>
            }
            </div>

            <div class="accordion-section">
                <button class="accordion-header" aria-expanded="@notesOpen" @onclick='() => State.ToggleSection(combatant.Id, "notes")'>
                    <i class="bi bi-journal-text"></i>
                    <span class="accordion-title">Notes</span>
                    <i class="bi @(notesOpen ? "bi-chevron-up" : "bi-chevron-down") accordion-chevron"></i>
                </button>
                @if (notesOpen)
                {
                <div class="accordion-body">
                    <textarea class="notes-textarea" value="@combatant.Notes" maxlength="@Combatant.MaxNotesLength"
                              placeholder="Personality, tactics, secrets - whatever's worth remembering about this character."
                              @oninput="e => SetNotes(combatant, e)"></textarea>
                </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-banner">@_error</div>
        }
    }
</div>

@code {
    private string _hpDelta = "";
    private bool _showAddRoll;
    private bool _showAddCounter;
    private bool _showAddCondition;
    private string _newRollName = "";
    private string _newRollFormula = "";
    private string _newRollCategory = "";
    private string _newCounterName = "";
    private int _newCounterMax = 3;
    private string _newCounterCategory = "";
    private Guid? _editingRollId;
    private string _editRollName = "";
    private string _editRollFormula = "";
    private string _editRollCategory = "";
    private Guid? _editingCounterId;
    private string _editCounterName = "";
    private int _editCounterMax;
    private string _editCounterCategory = "";
    private string? _error;

    private string? _openMenuTriggerId;
    private ElementReference _menuRef;
    private IJSObjectReference? _menuModule;
    private IJSObjectReference? _outsideClickHandle;
    private string? _outsideClickHandleTriggerId;
    private DotNetObjectReference<CharacterDetailPanel>? _dotNetRef;

    private static bool HasPortrait(Combatant c) => !string.IsNullOrEmpty(c.PortraitBase64);

    private static int IndexOf<T>(IReadOnlyList<T> list, T item)
    {
        for (var i = 0; i < list.Count; i++)
        {
            if (Equals(list[i], item))
            {
                return i;
            }
        }
        return -1;
    }

    private static IEnumerable<NamedRoll> FilterRolls(Combatant combatant, string filter) =>
        string.IsNullOrWhiteSpace(filter)
            ? combatant.NamedRolls
            : combatant.NamedRolls.Where(r => r.Name.Contains(filter, StringComparison.OrdinalIgnoreCase));

    private static IEnumerable<Counter> FilterCounters(Combatant combatant, string filter) =>
        string.IsNullOrWhiteSpace(filter)
            ? combatant.Counters
            : combatant.Counters.Where(c => c.Name.Contains(filter, StringComparison.OrdinalIgnoreCase));

    private bool IsMenuOpen(string triggerId) => _openMenuTriggerId == triggerId;

    private void ToggleMenu(string triggerId) =>
        _openMenuTriggerId = _openMenuTriggerId == triggerId ? null : triggerId;

    [JSInvokable]
    public void OnClickOutsideMenu()
    {
        _openMenuTriggerId = null;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        try
        {
            if (_openMenuTriggerId is not null)
            {
                _menuModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dropdownMenu.js");
                await _menuModule.InvokeVoidAsync("positionMenu", _openMenuTriggerId, _menuRef);

                if (_outsideClickHandleTriggerId != _openMenuTriggerId)
                {
                    await DisposeOutsideClickHandleAsync();
                    _dotNetRef ??= DotNetObjectReference.Create(this);
                    _outsideClickHandle = await _menuModule.InvokeAsync<IJSObjectReference>(
                        "registerOutsideClick", _openMenuTriggerId, _menuRef, _dotNetRef);
                    _outsideClickHandleTriggerId = _openMenuTriggerId;
                }
            }
            else
            {
                await DisposeOutsideClickHandleAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // circuit is going away - nothing to position or register
        }
    }

    private async Task DisposeOutsideClickHandleAsync()
    {
        if (_outsideClickHandle is null)
        {
            return;
        }

        var handle = _outsideClickHandle;
        _outsideClickHandle = null;
        _outsideClickHandleTriggerId = null;
        await handle.InvokeVoidAsync("dispose");
        await handle.DisposeAsync();
    }

    protected override async ValueTask DisposeAsyncCore()
    {
        try
        {
            await DisposeOutsideClickHandleAsync();
        }
        catch (JSDisconnectedException)
        {
            // circuit already gone
        }

        if (_menuModule is not null)
        {
            try
            {
                await _menuModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // circuit already gone
            }
        }

        _dotNetRef?.Dispose();
    }


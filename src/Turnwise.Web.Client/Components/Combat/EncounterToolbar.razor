@inherits EncounterStateAwareComponentBase
@inject EncounterFileService EncounterFileService
@inject FileDownloadService FileDownload
@inject IJSRuntime JS

<div class="app-header card">
    <div class="brand">
        <span class="brand-icon">⚔️</span>
        <span class="brand-title">Turnwise</span>
        <span class="version-badge" title="Pre-release - the save format may still change">@($"v{AppInfo.Version}")</span>
    </div>

    <div class="encounter-name-field">
        <input class="encounter-name-input" @bind="State.Current.Name" @bind:event="oninput" placeholder="Encounter name" maxlength="@Encounter.MaxNameLength" />
        <i class="bi bi-pencil"></i>
    </div>

    <div class="header-actions">
        <button class="icon-btn" title="Undo last action (Ctrl+Z)" disabled="@(!State.CanUndo)" @onclick="() => State.Undo()">
            <i class="bi bi-arrow-counterclockwise"></i>
        </button>
        <div class="menu-wrap">
            <button id="menu-trigger-settings" class="icon-btn" title="Encounter settings" @onclick="ToggleMenu">
                <i class="bi bi-gear-fill"></i>
            </button>
            @if (_menuOpen)
            {
                <div class="dropdown-menu" @ref="_menuRef">
                    <label class="dropdown-item file-button" title="Loading will overwrite the current encounter.">
                        <i class="bi bi-folder2-open"></i> Load Encounter
                        <InputFile OnChange="LoadEncounter" accept=".json" />
                    </label>
                    <button class="dropdown-item" @onclick="SaveEncounter"><i class="bi bi-save"></i> Save Encounter</button>
                    <button class="dropdown-item" @onclick="NewEncounter"><i class="bi bi-plus-lg"></i> New Encounter</button>
                </div>
            }
        </div>
    </div>
</div>
@if (!string.IsNullOrEmpty(_error))
{
    <div class="error-banner">@_error</div>
}

@code {
    private string? _error;
    private bool _menuOpen;
    private ElementReference _menuRef;
    private IJSObjectReference? _menuModule;
    private IJSObjectReference? _outsideClickHandle;
    private DotNetObjectReference<EncounterToolbar>? _dotNetRef;

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    [JSInvokable]
    public void OnClickOutsideMenu()
    {
        _menuOpen = false;
        StateHasChanged();
    }

    private void NewEncounter()
    {
        _menuOpen = false;
        State.NewEncounter();
    }

    private async Task SaveEncounter()
    {
        using var stream = new MemoryStream();
        await EncounterFileService.SaveEncounterAsync(State.Current, stream);
        var fileName = $"{Sanitize(State.Current.Name)}.turnwise-encounter.json";
        await FileDownload.DownloadAsync(fileName, "application/json", stream.ToArray());
        _menuOpen = false;
        State.NotifyChanged();
    }

    private async Task LoadEncounter(InputFileChangeEventArgs e)
    {
        try
        {
            await using var stream = e.File.OpenReadStream(maxAllowedSize: 10_000_000);
            var encounter = await EncounterFileService.LoadEncounterAsync(stream);
            State.ReplaceEncounter(encounter);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load encounter: {ex.Message}";
        }
        _menuOpen = false;
        State.NotifyChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        try
        {
            if (_menuOpen)
            {
                _menuModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dropdownMenu.js");
                await _menuModule.InvokeVoidAsync("positionMenu", "menu-trigger-settings", _menuRef);
                if (_outsideClickHandle is null)
                {
                    _dotNetRef ??= DotNetObjectReference.Create(this);
                    _outsideClickHandle = await _menuModule.InvokeAsync<IJSObjectReference>(
                        "registerOutsideClick", "menu-trigger-settings", _menuRef, _dotNetRef);
                }
            }
            else
            {
                await DisposeOutsideClickHandleAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // circuit is going away - nothing to position or register
        }
    }

    private async Task DisposeOutsideClickHandleAsync()
    {
        if (_outsideClickHandle is null)
        {
            return;
        }

        var handle = _outsideClickHandle;
        _outsideClickHandle = null;
        await handle.InvokeVoidAsync("dispose");
        await handle.DisposeAsync();
    }

    protected override async ValueTask DisposeAsyncCore()
    {
        try
        {
            await DisposeOutsideClickHandleAsync();
        }
        catch (JSDisconnectedException)
        {
            // circuit already gone
        }

        if (_menuModule is not null)
        {
            try
            {
                await _menuModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // circuit already gone
            }
        }

        _dotNetRef?.Dispose();
    }

    private static string Sanitize(string name) =>
        string.Concat(name.Where(c => !Path.GetInvalidFileNameChars().Contains(c))).Replace(' ', '-');
}
